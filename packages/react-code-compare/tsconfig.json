{
  "compilerOptions": {
    "experimentalDecorators": true,
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "target": "ES6",
    "declaration": true,
    "downlevelIteration": true,
    "lib": ["es2017", "dom"],
    "types": ["node"]
  },
  "include": ["./src/*", "src/diff.tsx"],
  "exclude": ["node_modules"]
}
