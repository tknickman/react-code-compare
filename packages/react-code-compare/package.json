    "emotion": "^10.0.14",
    "memoize-one": "^5.0.4",
    "prop-types": "^15.6.2"
  },
  "devDependencies": {
    "@types/classnames": "^2.2.6",
    "@types/diff": "^4.0.2",
    "@types/memoize-one": "^4.1.1",
    "@types/node": "^12.0.12",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "eslint": "^8.36.0",
    "eslint-config-custom": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
